# pagina_inma/.env.example — Panel ModaEnma (copia a .env y rellena con los datos de tu proyecto Firebase)
# Firebase Console → Configuración del proyecto → Tus apps → App web
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Fotos: Cloudinary (plan gratuito). Cloud Name y un Upload Preset en modo "Unsigned".
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Solo para probar en tu ordenador sin Firebase (datos de ejemplo en el navegador). NO en producción.
# VITE_DEMO=1

# Dirección de la tienda (para que el panel pueda avisar a los clientes por correo). Sin barra final.
VITE_STORE_URL=
