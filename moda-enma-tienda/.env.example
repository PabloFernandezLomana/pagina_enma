# moda-enma-tienda/.env.example  →  copia a .env.local y rellena. NUNCA subas .env.local.

# --- Firebase (público: se puede ver en el navegador, protegido por las reglas) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (PRIVADO, solo servidor) ---
# En local: JSON completo de la cuenta de servicio en una línea, o en base64.
# En Firebase App Hosting NO hace falta (usa credenciales automáticas).
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- PayPal (cuando crees la cuenta Business: developer.paypal.com → Apps & Credentials) ---
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox          # cambia a "live" cuando pases a cobros reales
PAYPAL_WEBHOOK_ID=          # ID del webhook https://TU-DOMINIO/api/paypal/webhook

# --- Otros ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# ALLOW_DEMO_CATALOG=true   # solo para enseñar la tienda sin base de datos; en producción déjalo sin poner
