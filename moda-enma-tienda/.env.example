# Variables de Entorno — ModaEnma Store (Next.js)

# Firebase Client SDK (Lectura pública segura)
NEXT_PUBLIC_FIREBASE_API_KEY=TODO-LANZAMIENTO
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=TODO-LANZAMIENTO.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=TODO-LANZAMIENTO
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=TODO-LANZAMIENTO.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=TODO-LANZAMIENTO
NEXT_PUBLIC_FIREBASE_APP_ID=TODO-LANZAMIENTO

# Firebase Admin SDK (Privado de servidor, jamás expuesto al navegador)
# Pega aquí el JSON completo de la cuenta de servicio como string o configura sus variables
FIREBASE_SERVICE_ACCOUNT_KEY=

# Pasarela PayPal (Único método digital permitido)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=TODO-LANZAMIENTO
PAYPAL_CLIENT_SECRET=TODO-LANZAMIENTO
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=

# Email transaccional opcional (P1)
RESEND_API_KEY=

