rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Solo cuentas con claim de administrador (ver scripts/set-admin.mjs)
    function isAdmin() {
      return request.auth != null &&
        (request.auth.token.admin == true || request.auth.token.role == 'admin');
    }

    // Catálogo: el público solo lee productos activos. Escribe solo el admin.
    match /products/{productId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.salePrice is number
        && request.resource.data.salePrice >= 0
        && request.resource.data.variants is list;
      allow delete: if isAdmin();
    }

    // Coste de compra de cada producto: privado (los productos son de lectura pública).
    match /products_private/{productId} { allow read, write: if isAdmin(); }

    // Pedidos y clientes: los crea SOLO el servidor (Admin SDK, salta las reglas).
    match /orders/{orderId}   { allow read, write: if isAdmin(); }
    match /clients/{clientId} { allow read, write: if isAdmin(); }
    match /invoices/{id}      { allow read, write: if isAdmin(); }
    match /templates/{id}     { allow read, write: if isAdmin(); }
    match /tasks/{id}         { allow read, write: if isAdmin(); }
    match /settings/{id}      { allow read, write: if isAdmin(); }

    // Estadísticas y contadores: los escribe el servidor; solo el admin las lee.
    match /stats_daily/{day}  { allow read: if isAdmin(); allow write: if false; }
    match /meta/{doc}         { allow read, write: if isAdmin(); }

    match /{document=**} { allow read, write: if false; }
  }
}
